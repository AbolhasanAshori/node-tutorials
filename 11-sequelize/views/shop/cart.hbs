<main>
  {{#if hasProducts}}
    <ul>
      {{#each products}}
        <li>
          <p>{{this.productData.title}} ({{this.qty}})</p>
          <form action="/cart-delete-item" method="post">
            <input type="hidden" name="productId" value="{{this.productData.id}}" />
            <button class="btn" type="submit">Delete</button>
          </form>
        </li>
      {{/each}}
    </ul>
  {{else}}
    <h1>No Products in Cart!</h1>
  {{/if}}
</main>