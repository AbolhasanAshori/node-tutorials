<main>
  {{#if hasOrders}}
    <ul class="orders">
      {{#each orders as |order|}}
        <li class="orders__item">
          <h1># {{order._id}}</h1>
          <ul class="orders__products">
            {{#each order.products as |product|}}
              <li class="orders__products-item">{{product.product.title}} ({{product.quantity}})</li>
            {{/each}}
          </ul>
        </li>
      {{/each}}
    </ul>
  {{else}}
    <h1>Nothing is here yet!</h1>
  {{/if}}
</main>