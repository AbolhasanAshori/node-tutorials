<main>
  <form class="product-form" action="/admin/{{#if editing}}edit-product{{else}}add-product{{/if}}" method="POST">
    <div class="form-control">
      <label for="title">Title</label>
      <input id="title" type="text" name="title" value="{{#if editing}}{{product.title}}{{/if}}" />
    </div>
    <div class="form-control">
      <label for="imageUrl">Image Url</label>
      <input id="imageUrl" type="text" name="imageUrl" value="{{#if editing}}{{product.imageUrl}}{{/if}}" />
    </div>
    <div class="form-control">
      <label for="price">Price</label>
      <input id="price" type="number" name="price" step="0.01" value="{{#if editing}}{{product.price}}{{/if}}" />
    </div>
    <div class="form-control">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="5">{{#if editing}}{{product.description}}{{/if}}</textarea>
    </div>
    {{#if editing}}
      <input type="hidden" name="productId" value="{{product._id}}" />
    {{/if}}
    <button class="btn" type="submit">{{#if editing}}Update Product{{else}}Add Product{{/if}}</button>
  </form>
</main>