<main>
  {{#each errorMessage}}
  {{#if @first}}
  <div class="user-message user-message--error">{{this}}</div>
  {{/if}}
  {{/each}}
  <form class="product-form" action="/admin/{{#if editing}}edit-product{{else}}add-product{{/if}}" method="POST">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    <div class="form-control">
      <label for="title">Title</label>
      <input class="{{#if errors.title}}invalid{{/if}}" id="title" type="text" name="title"
        value="{{formData.title}}" />
    </div>
    <div class="form-control">
      <label for="imageUrl">Image Url</label>
      <input class="{{#if errors.imageUrl}}invalid{{/if}}" id="imageUrl" type="text" name="imageUrl"
        value="{{formData.imageUrl}}" />
    </div>
    <div class="form-control">
      <label for="price">Price</label>
      <input class="{{#if errors.price}}invalid{{/if}}" id="price" type="number" name="price" step="0.01"
        value="{{formData.price}}" />
    </div>
    <div class="form-control">
      <label for="description">Description</label>
      <textarea class="{{#if errors.description}}invalid{{/if}}" id="description" name="description"
        rows="5">{{formData.description}}</textarea>
    </div>
    {{#if editing}}
    <input type="hidden" name="productId" value="{{formData._id}}" />
    {{/if}}
    <button class="btn" type="submit">{{#if editing}}Update Product{{else}}Add Product{{/if}}</button>
  </form>
</main>