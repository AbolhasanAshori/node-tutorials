<main>
  {{#each errorMessage}}
  {{#if @first}}
  <div class="user-message user-message--error">{{this}}</div>
  {{/if}}
  {{/each}}
  <form class="login-form" action="/signup" method="post" novalidate>
    <input type="hidden" name="_csrf" value="{{csrfToken}}" />
    <div class="form-control">
      <label for="email">E-Mail</label>
      <input type="email" name="email" id="email" value="{{formData.email}}" />
    </div>
    <div class="form-control">
      <label for="password">Password</label>
      <input type="password" name="password" id="password" minlength="5" value="{{formData.password}}" />
    </div>
    <div class="form-control">
      <label for="confirmPassword">Confirm Password</label>
      <input type="password" name="confirmPassword" id="confirmPassword" value="{{formData.confirmPassword}}" />
    </div>
    <button class="btn" type="submit">Sign up</button>
  </form>
</main>